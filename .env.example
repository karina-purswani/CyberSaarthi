# CyberSaarthi Environment Configuration Example
# Copy to .env for local adjustments

APP_NAME="CyberSaarthi Evidence Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration
DATABASE_URL="sqlite:///./cybersaarthi.db"

# Storage Configuration
STORAGE_DIR="./storage/evidence"
MAX_UPLOAD_SIZE_MB=15

# Allowed CORS Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Processing Options
OCR_ENGINE="rapidocr" # options: rapidocr, fallback
SPEECH_ENGINE="whisper_or_mock" # optional fallback
