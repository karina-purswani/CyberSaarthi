# CyberSaarthi Environment Configuration Example
# Copy to .env for local adjustments

APP_NAME="CyberSaarthi Evidence Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration
DATABASE_URL="sqlite:///./cybersaarthi.db"

# Storage Configuration
STORAGE_DIR="./storage/evidence"
MAX_UPLOAD_SIZE_MB=15

# Allowed CORS Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Processing Options
OCR_ENGINE="rapidocr" # options: rapidocr, fallback
SPEECH_ENGINE="whisper_or_mock" # optional fallback

# Email & Report Dispatch Configuration
# For real SMTP delivery, specify your SMTP provider credentials (e.g., Gmail App Password, Mailtrap, AWS SES)
# If SMTP_HOST is left empty, the platform operates in safe simulation mode (compiles & validates full email + PDF dossier)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=True
SMTP_SSL=False
EMAIL_FROM="CyberSaarthi Platform <no-reply@cybersaarthi.local>"

# Controlled demonstration recipient inbox
CYBERSAARTHI_TEST_EMAIL="purswani2276@gmail.com"

# Web Application Frontend URL (for links in report emails)
FRONTEND_BASE_URL="http://localhost:5173"
